      "category": "direct-factual",
      "setup": {
        "conversations": [
          {
            "id": "conv:direct",
            "title": "预算会议",
            "started_at": "2026-03-01T09:00:00Z",
            "turns": [
              {
                "id": "turn:direct:1",
                "text": "季度预算已批准，金额为八十万元，截止日期是三月十五日。",
                "start_ms": 0
              }
            ]
          }
        ],
        "assessor": "ok"
      },
      "query": "季度预算的金额和截止日期",
      "expected_status": "sufficient",
      "expected_evidence_turns": [
        "turn:direct:1"
      ],
      "forbidden_evidence_turns": [],
      "required_terms": [
        "八十万元",
        "三月十五日"
      ],
      "forbidden_terms": [],
      "unanswerable": false,
      "notes": "Direct factual answer fully present in one turn."
