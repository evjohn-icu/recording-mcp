# recording-mcp 环境变量样例 — 复制为 .env 并填入真实值；不要提交真实 key。

# 真实 ASR（doubao/ark 端点），bin/asr-ingest 使用
VOLC_API_KEY=

# openai 提炼：bin/context-worker --generator openai 从该变量读 key（--generator-key-env）
GENERATOR_API_KEY=

# openai 嵌入：worker --embed-provider openai 与 bin/context-memory --semantic-provider openai
# 共用该变量（--embed-key-env / --semantic-key-env）
EMBED_API_KEY=

# 云端同步（ingest-v1）：bin/context-sync 用该变量读 sync token（--sync-token-env）
# 值由管理面 POST /v1/admin/sync-tokens 签发，仅显示一次
CF_SYNC_TOKEN=

# 云端管理 token：wrangler dev 本地用 .dev.vars，生产用 wrangler secret put；
# 用于签发配对码 / sync token / 撤销凭据（apps/cloud-ingest 管理面）
ADMIN_TOKEN=

# 可选 Brief 润色（local-start.sh 读取环境变量；默认关闭，不自动加载 .env）
# 显式复用 Pi models.json 中已有的 provider；密钥不会复制到本文件。
# BRIEF_POLISH_PI_PROVIDER=your-provider
# BRIEF_POLISH_MODEL=your-model
# BRIEF_POLISH_PI_MODELS_FILE=/path/to/models.json
# 或配置独立端点（不得与 PI_PROVIDER 混用）：
# BRIEF_POLISH_ENDPOINT=https://your-provider.example/v1/chat/completions
# BRIEF_POLISH_KEY_ENV=YOUR_EXISTING_KEY_ENV

# 本地 Beta 容器部署（docker compose 读取 .env）
# profile 名称与解锁密码；密码只来自环境变量，不写入镜像
RECORDING_PROFILE=home
MEMORY_PROFILE_PASSWORD=
# 宿主发布端口（容器内仍监听 8788；默认 127.0.0.1:8788）
WEB_PORT=8788
# web 与 worker 共用：off|fixture|doubao|ark|qwen|local；doubao 需要 VOLC_API_KEY
# ark/qwen 为宿主机本地模型（float16），容器镜像不含 Python/torch；见 docs/productization/local-asr.md
ASR_PROVIDER=off
# 本地 ASR（scripts/local-start.sh 透传给 web 与 worker；compose 不转发）：
# ASR_PROVIDER=ark
# ASR_BACKEND=ark
# ASR_MODEL=
# ASR_PYTHON=.venv-asr/bin/python
# ASR_DEVICE=cuda:0
# 留空即固定到已验证快照；自定义模型时请显式指定 revision
# ASR_REVISION=
GENERATOR_PROVIDER=off
EMBED_PROVIDER=hash
